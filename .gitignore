# ---- Secrets / security material (CLAUDE.md §13, §17.4) ----
certs/
.flwr_home/
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
.env
.env.*
secrets/

# ---- Patient data / datasets (never commit the images themselves) ----
data/*
datasets/
*.dcm
*.dicom
# ...but DO track reproducible split manifests and checksums (CLAUDE.md 12)
!data/partitions/
data/partitions/*
!data/partitions/*.json
!data/partitions/.gitkeep
!data/manifests/
data/manifests/*
!data/manifests/*.json
!data/manifests/.gitkeep

# ---- Experiment outputs ----
mlruns/
mlartifacts/
mlruns.db
mlflow.db
outputs/
multirun/
.hydra/
runs/
checkpoints/
*.pth
*.pt
*.ckpt
*.onnx
cache/
.cache/

# ---- Python ----
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- PneumoScan frontend (Node/React) ----
# node_modules is always regenerable from package-lock.json via `npm ci`.
# frontend/dist/ is the OPPOSITE: it must be committed, not ignored, since
# Streamlit Community Cloud's build environment is Python/pip only and
# cannot run `npm run build` itself -- the plan's Risk #1/#2. The blanket
# `dist/` rule above would otherwise silently swallow it.
app/pneumoscan_component/frontend/node_modules/
!app/pneumoscan_component/frontend/dist/

# ---- Testing / tooling ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
