# Stage 17 — Docker Compose multi-client deployment.
#
# Runs `flower-supernode`. The `flwr-clientapp` subprocess that actually trains
# (Stage 13/14's client_app.py) executes inside this same container (default
# `--isolation subprocess`), so it needs the same full ML dependency stack and
# src/ as the server image — see Dockerfile.server for the CPU-only-build
# rationale (DG-9, owner-approved 2026-08-30), which applies identically here.
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv==0.11.33

# Direct `uv pip install` at the exact same pinned versions as pyproject.toml,
# not `uv sync` against the committed uv.lock — see Dockerfile.server for why
# (uv.lock's CUDA-oriented resolution isn't pruned by `--no-install-package`,
# pulling in ~2GB of unused nvidia-*-cu12 shared libraries). Same trade-off
# applies identically here.
RUN uv pip install --system --no-cache \
        torch==2.13.0 torchvision==0.28.0 --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install --system --no-cache \
        flwr==1.35.0 \
        opacus==1.6.0 \
        opencv-python-headless==5.0.0.93 \
        hydra-core==1.3.5 \
        omegaconf==2.3.1 \
        mlflow==3.15.2 \
        numpy==2.4.6 \
        pandas==2.3.3 \
        scikit-learn==1.9.0 \
        pydicom==3.0.2 \
        pillow==12.3.0 \
        tqdm==4.70.0 \
        matplotlib==3.11.1 \
        grad-cam==1.5.7 \
        requests==2.34.2

COPY src ./src
COPY pyproject.toml ./

ENTRYPOINT ["flower-supernode"]
